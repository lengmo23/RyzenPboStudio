<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RyzenPboStudio</RootNamespace>
    <AssemblyName>AMD Ryzen PBO Studio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\ICON.ico</ApplicationIcon>
    <Version>3.0.4</Version>
    <!-- Assembly metadata shown in the executable's Details properties. -->
    <Product>AMD Ryzen PBO Studio</Product>
    <Authors>@lengmo23</Authors>
    <Company>@lengmo23</Company>
    <Copyright>Copyright © 2026 @lengmo23. Licensed under GPL-3.0.</Copyright>
    <Description>AMD Ryzen Curve Optimizer 负压测试与自动调整工具</Description>
    <!-- Fix the build date at compile time instead of reading file timestamps at runtime. -->
    <BuildDate>$([System.DateTime]::Now.ToString("yyyy-MM-dd"))</BuildDate>
    <!-- CPU detection uses registry and Win32 APIs instead of wmic. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WinForms needs culture 1033 when handling WM_INPUTLANGCHANGE;
         invariant mode would throw CultureNotFoundException. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ToolBundlePath>obj\$(Configuration)\$(TargetFramework)\tool-bundle.zip</ToolBundlePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\third_party\ZenStates-Core\ZenStates-Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Store the build date in assembly metadata for stable display. -->
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle inpoutx64.dll for ZenStates-Core; extract it to protected ProgramData
         and verify SHA-256 to avoid loading a writable DLL beside the executable.
         Keep external y-cruncher under tools\y-cruncher\ in the publish folder. -->
    <ToolBundleSource Include="..\ryzen-smu-cli-0.1.3\inpoutx64.dll" />
    <ToolBundleSource Include="..\ryzen-smu-cli-0.1.3\InpOut.LICENSE.txt" />
    <ToolBundleSource Include="..\THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="$(ToolBundlePath)"
                      LogicalName="RyzenPboStudio.Resources.tool-bundle.zip" />
    <!-- Embed the icon for runtime window and taskbar use. -->
    <EmbeddedResource Include="..\ICON.ico" LogicalName="RyzenPboStudio.ICON.ico" />
    <!-- Payment QR codes for the sponsor dialog (JPEG data despite the .png name). -->
    <EmbeddedResource Include="..\Alipay.png" LogicalName="RyzenPboStudio.Alipay.png" />
    <EmbeddedResource Include="..\Wechat.png" LogicalName="RyzenPboStudio.Wechat.png" />
  </ItemGroup>

  <Target Name="GenerateEmbeddedToolBundle"
          BeforeTargets="PrepareResources"
          Inputs="@(ToolBundleSource);..\Scripts\build-tool-bundle.ps1"
          Outputs="$(ToolBundlePath)">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Scripts\build-tool-bundle.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)\..&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\$(ToolBundlePath)&quot;" />
  </Target>

  <Target Name="CleanEmbeddedToolBundle" AfterTargets="Clean">
    <Delete Files="$(ToolBundlePath)" />
  </Target>

  <!-- Publish y-cruncher under tools\y-cruncher when present;
       skip it when absent from the local open-source checkout. -->
  <Target Name="CopyYCruncherToPublish" AfterTargets="Publish">
    <ItemGroup>
      <YCruncherFile Include="..\y-cruncher v0.8.7.9547b\**\*" />
    </ItemGroup>
    <Copy Condition="'@(YCruncherFile)' != ''"
          SourceFiles="@(YCruncherFile)"
          DestinationFiles="@(YCruncherFile->'$(PublishDir)tools\y-cruncher\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Condition="'@(YCruncherFile)' == ''" Importance="high"
             Text="y-cruncher not found locally; published without it (user supplies it in tools\y-cruncher\)." />
  </Target>

</Project>
